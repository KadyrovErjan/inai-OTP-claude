# OTP Secure configuration. Copy to .env:  python scripts/init_env.py
# (generates strong random OTP_HMAC_KEY / ADMIN_API_KEY for you)

APP_ENV=development
DEBUG=false

HOST=127.0.0.1
PORT=8000

# API on the host (jury mode): Redis on localhost
REDIS_URL=redis://127.0.0.1:6379/0
# Inside docker-compose.yml the API uses redis://redis:6379/0 (set in the compose file)

# All values are REAL seconds
OTP_TTL=120
OTP_LENGTH=6

SEND_WINDOW_SECONDS=600
MAX_SEND_PER_WINDOW=3

SEND_COOLDOWN_1=30
SEND_COOLDOWN_2=60
SEND_COOLDOWN_3=120

MAX_VERIFY_ATTEMPTS=5
PHONE_BLOCK_SECONDS=900

IP_VERIFY_LIMIT=20
IP_VERIFY_WINDOW=60

# >= 32 random characters each, must differ. Never commit real values.
# python -c "import secrets; print(secrets.token_urlsafe(48))"
OTP_HMAC_KEY=
ADMIN_API_KEY=

# Demo SMS delivery for the jury (relative paths are resolved from the project root)
OUTBOX_PATH=outbox/sms.jsonl
OUTBOX_ENABLED=true

DEMO_MODE=true
# Client IP = real TCP peer. Keep false: X-Forwarded-For is never trusted.
TRUST_PROXY_HEADERS=false
